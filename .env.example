# Signaling Server Port (Default is 3000)
PORT=3000

# Optional Signaling Server URL for Electron Client (Default is http://localhost:3000)
# Useful when hosting the signaling server on a LAN IP (e.g. http://192.168.1.50:3000) or remote VPS
SIGNALING_SERVER_URL=http://localhost:3000

# Optional TURN Server Configuration (Fallback for Symmetric NATs and restrictive firewalls)
# If not provided, PeerConnect uses Google's public STUN servers for discovery.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Example for coturn or metered.ca / twilio TURN services:
# TURN_URL=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=user123
# TURN_CREDENTIAL=secretpassword123
